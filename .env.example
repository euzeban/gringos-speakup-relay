# Chave Gemini (a MESMA do app, mas aqui ela fica SÓ no servidor, nunca vai pro browser)
GEMINI_API_KEY=AIza...

# Segredo compartilhado com o app Next (mesma string nos dois lados).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPEAKUP_RELAY_SECRET=cole-o-mesmo-segredo-do-app-aqui

# Origens permitidas a conectar (separadas por vírgula). Deixe vazio pra aceitar qualquer.
ALLOWED_ORIGINS=https://dashboard.gringosacademy.com,https://app.gringosacademy.com

# Opcional: modelo Live (default já é o certo)
LIVE_MODEL=gemini-3.1-flash-live-preview

PORT=8080
